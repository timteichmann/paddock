#!/usr/bin/env bash
# paddock - isolated coding-agent instances on rootless Podman.
# Copyright (C) 2026 Tim Teichmann
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Each instance = one agent container (internal network only, no route out)
# + one Squid proxy container (internal + external network) that enforces a
# per-instance domain allowlist. The agent can see exactly one host directory.
#
# See README.md for the design; `paddock help` for usage.

set -euo pipefail
shopt -s nullglob

readonly PADDOCK_VERSION="0.1.0"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/paddock"
readonly INSTANCES_DIR="$CONFIG_DIR/instances"
readonly LABEL_KEY="paddock.instance"
readonly PROXY_PORT=3128
readonly PROXY_IMAGE="localhost/paddock-proxy:latest"
readonly BASE_IMAGE="localhost/paddock-base:latest"
readonly AGENT_IMAGE_PREFIX="localhost/paddock-"   # + <tool>:<version>
readonly INST_IMAGE_REPO="localhost/paddock-inst"  # + :<instance>, tool image + packages.txt
DATA_DIR=""
readonly NAME_RE='^[a-z0-9][a-z0-9-]{0,30}$'
# exact:  label(.label)+      wildcard: .label(.label)+
# Last label must start with a letter, so IPv4 literals are rejected.
readonly DOMAIN_RE='^\.?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$'
# pacman package or group name, e.g. godot, base-devel, gtk4, libc++.
readonly PACKAGE_RE='^[A-Za-z0-9@_+][A-Za-z0-9@._+-]{0,127}$'
readonly VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$'

# ---------------------------------------------------------------- helpers --

die()  { printf 'paddock: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'paddock: warning: %s\n' "$*" >&2; }
info() { printf 'paddock: %s\n' "$*" >&2; }

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed"; }

# Write stdin to $1 atomically (same directory, then rename).
atomic_write() {
  local dest=$1 tmp
  tmp=$(mktemp "$(dirname "$dest")/.$(basename "$dest").XXXXXX")
  cat >"$tmp" || { rm -f "$tmp"; return 1; }
  chmod "${2:-0644}" "$tmp"
  mv -f "$tmp" "$dest"
}

have_tty() { (exec </dev/tty) 2>/dev/null; }

confirm() {
  local reply
  have_tty || die "cannot ask for confirmation (no terminal); use --force"
  printf '%s [y/N] ' "$1" >/dev/tty
  read -r reply </dev/tty || return 1
  [[ $reply == [yY] || $reply == [yY][eE][sS] ]]
}

# ----------------------------------------------------------------- config --

# Shipped defaults (config, domains, Containerfiles, tool definitions) live in
# the data dir. A file at the same relative path under $CONFIG_DIR replaces
# the shipped one; `config` is merged key by key instead.
find_data_dir() {
  local self d
  self=$(realpath -- "${BASH_SOURCE[0]}")
  # <prefix>/bin/paddock -> <prefix>/share/paddock covers any install prefix.
  for d in ${PADDOCK_DATA_DIR:+"$PADDOCK_DATA_DIR"} "$(dirname "$self")/share" \
           "$(dirname "$(dirname "$self")")/share/paddock" \
           "${XDG_DATA_HOME:-$HOME/.local/share}/paddock" /usr/local/share/paddock /usr/share/paddock; do
    [[ -f $d/config && -d $d/tools ]] && { printf '%s' "$d"; return 0; }
  done
  die "paddock data dir not found (set PADDOCK_DATA_DIR or install share/ to ~/.local/share/paddock)"
}

# Path of a data file: the user's override if present, else the shipped file.
# Prints nothing (and fails) if neither exists.
data_file() {
  local rel=$1
  if [[ -f $CONFIG_DIR/$rel ]]; then printf '%s' "$CONFIG_DIR/$rel"
  elif [[ -f $DATA_DIR/$rel ]]; then printf '%s' "$DATA_DIR/$rel"
  else return 1; fi
}

# Parse KEY=VALUE lines of $1 into the associative array named $2. With
# $3 = new, unknown keys are added; otherwise they are an error.
parse_kv() {
  local f=$1 mode=${3-} line key val n=0
  local -n kv=$2
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [[ -z $line ]] && continue
    [[ $line == *=* ]] || die "$f:$n: expected KEY=VALUE"
    key="${line%%=*}"; val="${line#*=}"
    [[ $key =~ ^[a-z0-9_]+$ ]] || die "$f:$n: invalid key '$key'"
    [[ $mode == new || -v kv[$key] ]] || die "$f:$n: unknown setting '$key'"
    kv["$key"]=$val
  done <"$f"
}

declare -A CFG=()
load_config() {
  parse_kv "$DATA_DIR/config" CFG new
  # agents_md is no longer used; accepted so that old configs still load.
  [[ -v CFG[agents_md] ]] || CFG[agents_md]=""
  [[ -f $CONFIG_DIR/config ]] && parse_kv "$CONFIG_DIR/config" CFG
  [[ -z ${CFG[agents_md]} ]] \
    || warn "config: agents_md is no longer used (paddock does not write AGENTS.md into workspaces); remove it from $CONFIG_DIR/config"
  [[ ${CFG[relabel]-} =~ ^[zZ]?$ ]] || die "config: relabel must be empty, 'z' or 'Z'"
  local k
  for k in agent_pids_limit proxy_pids_limit; do
    [[ ${CFG[$k]-} =~ ^[0-9]*$ ]] || die "config: $k must be a number or empty"
  done
}

init_config_dir() {
  umask 077
  mkdir -p "$INSTANCES_DIR"
  chmod 700 "$CONFIG_DIR"
  umask 022
  DATA_DIR=$(find_data_dir)
  load_config
}

# Built image version per tool, in $CONFIG_DIR/images (tool=version).
tool_version() {
  local f="$CONFIG_DIR/images"
  [[ -f $f ]] || return 0
  sed -n "s/^$1=//p" "$f" | tail -n1
}

set_tool_version() { # tool version
  local f="$CONFIG_DIR/images"
  # grep -v exits 1 when no other lines remain; that must not abort under set -e.
  { if [[ -f $f ]]; then grep -v "^$1=" "$f" || true; fi; printf '%s=%s\n' "$1" "$2"; } | atomic_write "$f" 0644
}

# Tools with a tool.conf in the data dir or the config dir.
list_tools() {
  local d
  for d in "$DATA_DIR"/tools/*/ "$CONFIG_DIR"/tools/*/; do
    [[ -f $d/tool.conf ]] && basename "$d"
  done | sort -u
}

# Load tools/<tool>/tool.conf into TOOL.
declare -A TOOL=()
load_tool() {
  local t=$1 f
  [[ $t =~ $NAME_RE && $t != base && $t != proxy && $t != inst ]] || die "invalid tool name '$t'"
  f=$(data_file "tools/$t/tool.conf") \
    || die "unknown tool '$t' (available: $(list_tools | paste -sd' '))"
  TOOL=([command]="" [yolo_args]="" [npm_package]="" [protect_paths]="")
  parse_kv "$f" TOOL
  [[ -n ${TOOL[command]} ]] || die "$f: command is required"
  local p
  for p in ${TOOL[protect_paths]}; do
    # One top-level name: a mount point cannot be renamed, but the agent could
    # rename a parent directory of a deeper one and put its own in place.
    [[ $p =~ ^[A-Za-z0-9._-]+/?$ && ${p%/} != . && ${p%/} != .. && ${p%/} != .git ]] \
      || die "$f: invalid protect_paths entry '$p' (a file or dir/ directly in the workspace, not .git)"
  done
  TOOL[name]=$t
}

# --------------------------------------------------------------- validate --

validate_name() {
  [[ ${1-} =~ $NAME_RE ]] || die "invalid instance name '${1-}' (must match $NAME_RE)"
}

instance_dir() { printf '%s/%s' "$INSTANCES_DIR" "$1"; }

require_instance() {
  validate_name "$1"
  [[ -d $(instance_dir "$1") ]] || die "no such instance '$1' (see 'paddock list')"
}

# Normalize a domain (lowercase) or die.
normalize_domain() {
  local d=${1,,}
  if [[ ${#d} -gt 254 || ! $d =~ $DOMAIN_RE ]]; then
    die "invalid domain '$1' (use example.com or .example.com; no IPs, URLs, ports or wildcards)"
  fi
  printf '%s' "$d"
}

# Print validated domains from a file (comments/blank lines ignored; several
# domains on a line are separated by whitespace), one per line.
read_domains() {
  local f=$1 line n=0 w d
  local -a words
  [[ -f $f ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    line="${line%%#*}"
    read -r -a words <<<"$line"   # no glob expansion, unlike an unquoted $line
    for w in "${words[@]}"; do
      d=${w,,}
      if [[ ${#d} -gt 254 || ! $d =~ $DOMAIN_RE ]]; then
        printf 'paddock: error: %s:%d: invalid domain %q\n' "$f" "$n" "$w" >&2
        return 1
      fi
      printf '%s\n' "$d"
    done
  done <"$f"
}

# Print validated pacman package names from a file (comments/blank lines
# ignored), one per line.
read_packages() {
  local f=$1 line n=0 p
  local -a words
  [[ -f $f ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    line="${line%%#*}"
    read -r -a words <<<"$line"   # no glob expansion, unlike an unquoted $line
    for p in "${words[@]}"; do
      if [[ ! $p =~ $PACKAGE_RE ]]; then
        printf 'paddock: error: %s:%d: invalid package name %q\n' "$f" "$n" "$p" >&2
        return 1
      fi
      printf '%s\n' "$p"
    done
  done <"$f"
}

validate_package() {
  [[ $1 =~ $PACKAGE_RE ]] || die "invalid package name '$1' (an Arch repository package, e.g. godot)"
}

# Load instance $1's packages (sorted, unique) into the array named $2.
load_packages() {
  local -n _pkgs=$2
  local list
  list=$(read_packages "$(instance_dir "$1")/packages.txt" | sort -u) || exit 1
  _pkgs=()
  [[ -z $list ]] || mapfile -t _pkgs <<<"$list"
}

# Remove duplicates and entries covered by a wildcard (Squid treats overlaps
# as fatal). stdin -> stdout, sorted.
dedupe_domains() {
  sort -u | awk '
    { d[NR] = $0; if (substr($0, 1, 1) == ".") wild[$0] = 1 }
    END {
      for (i = 1; i <= NR; i++) {
        x = d[i]; covered = 0
        # x itself (exact "a.b") is covered by ".a.b"
        if (substr(x, 1, 1) != "." && (("." x) in wild)) covered = 1
        # any proper parent suffix ".b.c" covers x
        s = (substr(x, 1, 1) == ".") ? substr(x, 2) : x
        while (!covered && (p = index(s, ".")) > 0) {
          s = substr(s, p + 1)
          if (("." s) in wild) covered = 1
        }
        if (!covered) print x
      }
    }' | sort
}

# True if one of the absolute paths $1 and $2 is, or contains, the other.
paths_overlap() { [[ $1 == "$2" || $1 == "$2"/* || $2 == "$1"/* ]]; }

# Resolve and vet a workspace path; prints absolute path. Extra paths the
# workspace must not overlap can be passed after the path.
check_workspace_path() {
  local p=$1 home s; shift
  home=$(realpath -m -- "$HOME")
  p=$(realpath -m -- "$p")
  if [[ $p == / ]]; then die "refusing to use / as a workspace"; fi
  if [[ $p == "$home" ]]; then die "refusing to use \$HOME ($home) as a workspace"; fi
  if [[ $home == "$p"/* ]]; then die "refusing to use $p: it is a parent of \$HOME"; fi
  # Hidden directories in $HOME hold settings, keys and programs the host
  # uses (~/.config, ~/.local, ~/.ssh, ...).
  if [[ $p == "$home"/.* ]]; then die "refusing to use $p: it is in a hidden directory of \$HOME"; fi
  # paddock itself, its config and data, and the user's runtime dir (sockets).
  for s in "$CONFIG_DIR" "${DATA_DIR:-}" "$(dirname "$(realpath -- "${BASH_SOURCE[0]}")")" \
           "${XDG_CONFIG_HOME:-}" "${XDG_DATA_HOME:-}" "${XDG_RUNTIME_DIR:-}" "$@"; do
    [[ -n $s ]] || continue
    s=$(realpath -m -- "$s")
    if paths_overlap "$p" "$s"; then
      die "refusing to use $p: it overlaps $s (paddock, its config or data, your runtime dir or Podman's storage)"
    fi
  done
  printf '%s' "$p"
}

# Refuse a workspace that contains, or is inside, another instance's
# workspace: an agent could replace the inner directory with a symlink and so
# change what the other instance mounts. The same workspace is fine.
check_workspace_overlap() { # name ws
  local d other ows
  for d in "$INSTANCES_DIR"/*/; do
    other=$(basename "$d")
    [[ $other == "$1" ]] && continue
    ows=$(cat "$d/workspace" 2>/dev/null) || continue
    if [[ -n $ows && $ows != "$2" ]] && paths_overlap "$2" "$ows"; then
      die "workspace $2 overlaps the workspace of instance '$other' ($ows); nested workspaces are not supported"
    fi
  done
}

# The instance's workspace, checked again before its containers are created
# or started: it must still resolve to the path chosen at create.
verify_workspace() { # name -> prints ws
  local name=$1 ws real
  ws=$(<"$(instance_dir "$name")/workspace")
  [[ -d $ws ]] || die "workspace $ws does not exist"
  real=$(realpath -e -- "$ws")
  [[ $real == "$ws" ]] || die "workspace $ws now resolves to $real; to use that, remove the instance and create it again"
  check_workspace_overlap "$name" "$ws"
  printf '%s' "$ws"
}

# ------------------------------------------------------------------ podman --

agent_ctr() { printf 'pd-%s-agent' "$1"; }
proxy_ctr() { printf 'pd-%s-proxy' "$1"; }
int_net()   { printf 'pd-%s-int' "$1"; }
ext_net()   { printf 'pd-%s-ext' "$1"; }
home_vol()  { printf 'pd-%s-home' "$1"; }

ctr_exists() { podman container exists "$1"; }
ctr_state()  { podman container inspect --format '{{.State.Status}}' "$1" 2>/dev/null || echo missing; }
ctr_running() { [[ $(ctr_state "$1") == running ]]; }

instance_tool() {
  local t
  t=$(cat "$(instance_dir "$1")/tool" 2>/dev/null) || die "instance '$1' has no tool file"
  [[ $t =~ $NAME_RE ]] || die "instance '$1' has an invalid tool '$t'"
  printf '%s' "$t"
}

agent_image() { # tool
  local v; v=$(tool_version "$1")
  [[ -n $v ]] || die "no image built for tool '$1' yet; run 'paddock build $1' first"
  printf '%s%s:%s' "$AGENT_IMAGE_PREFIX" "$1" "$v"
}

require_images() { # tool
  local img
  img=$(agent_image "$1")
  podman image exists "$img" || die "agent image $img not found; run 'paddock build $1 --version $(tool_version "$1")'"
  podman image exists "$PROXY_IMAGE" || die "proxy image $PROXY_IMAGE not found; run 'paddock build $1'"
}

# --------------------------------------------------------- instance image --

# Instances with packages (instances/<name>/packages.txt) run a per-instance
# image: the tool image plus those packages, built on the host (not through
# the instance's proxy). Instances without packages use the tool image.
inst_image() { printf '%s:%s' "$INST_IMAGE_REPO" "$1"; }

# Image instance $1's agent container is created from.
instance_image() {
  local -a pkgs
  load_packages "$1" pkgs
  if ((${#pkgs[@]})); then inst_image "$1"; else agent_image "$(instance_tool "$1")"; fi
}

# Value of label $2 of podman object $1 ("" if unset). Parsed from the JSON,
# since template indexing into labels differs between podman versions.
object_label() {
  podman inspect "$1" 2>/dev/null \
    | sed -n "s/^ *\"${2//./\\.}\": \"\(.*\)\",\{0,1\}\$/\1/p" | head -n1
}

# Containerfile of an instance image: parent image $1 plus packages $2...
# Arch does not support partial upgrades, so this is a full -Syu.
inst_containerfile() {
  local parent=$1; shift
  printf '# generated by paddock\nFROM %s\n' "$parent"
  printf 'RUN pacman -Syu --noconfirm --needed %s \\\n' "$*"
  printf ' && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/* \\\n'
  printf ' && find / -xdev -perm /6000 -type f -exec chmod ug-s {} +\n'
}

# Build instance $1's image for packages $2... unless it is up to date (same
# packages, same tool image). Does nothing without packages. Returns 1 if the
# build fails; the previous image is then kept.
build_inst_image() {
  local name=$1; shift
  (($#)) || return 0
  local tool parent pid cf hash img old ctx rc=0
  tool=$(instance_tool "$name")
  parent=$(agent_image "$tool")
  pid=$(podman image inspect --format '{{.Id}}' "$parent") || return 1
  cf=$(inst_containerfile "$parent" "$@")
  hash=$(printf '%s\n%s\n' "$pid" "$cf" | sha256sum | cut -d' ' -f1)
  img=$(inst_image "$name")
  if podman image exists "$img"; then
    [[ $(object_label "$img" paddock.inst-hash) == "$hash" ]] && return 0
    old=$(podman image inspect --format '{{.Id}}' "$img")
  fi
  info "building $img: $parent + $*"
  ctx=$(mktemp -d)
  printf '%s\n' "$cf" >"$ctx/Containerfile"
  podman build --pull=never -t "$img" \
    --label paddock.image=instance --label "$LABEL_KEY=$name" \
    --label "paddock.tool=$tool" --label "paddock.inst-hash=$hash" \
    -f "$ctx/Containerfile" "$ctx" || rc=1
  rm -rf -- "$ctx"
  ((rc == 0)) || return 1
  # The previous image is now untagged; drop it unless a container uses it.
  [[ -n ${old-} ]] && rm_dangling_inst_image "$old"
  return 0
}

# Remove image $1 if it is an untagged instance image no container uses.
rm_dangling_inst_image() {
  [[ -n $1 ]] || return 0
  [[ $(podman image inspect --format '{{len .RepoTags}}' "$1" 2>/dev/null) == 0 ]] || return 0
  [[ $(object_label "$1" paddock.image) == instance ]] || return 0
  podman rmi "$1" >/dev/null 2>&1 || true
}

ip2int() {
  local IFS=.
  # shellcheck disable=SC2086
  set -- $1
  printf '%d' $(( ($1 << 24) | ($2 << 16) | ($3 << 8) | $4 ))
}
int2ip() { local n=$1; printf '%d.%d.%d.%d' $(( (n >> 24) & 255 )) $(( (n >> 16) & 255 )) $(( (n >> 8) & 255 )) $(( n & 255 )); }

# The internal network's IPv4 subnet (CIDR).
int_subnet() {
  local s
  s=$(podman network inspect --format '{{range .Subnets}}{{.Subnet}} {{end}}' "$(int_net "$1")" 2>/dev/null) \
    || die "network $(int_net "$1") is missing; run 'paddock recreate $1'"
  for s in $s; do
    [[ $s == *.*.*.*/* ]] && { printf '%s' "$s"; return 0; }
  done
  die "network $(int_net "$1") has no IPv4 subnet"
}

# Static proxy address on the internal network: last usable host address.
proxy_ip() {
  local cidr base prefix mask net bcast
  cidr=$(int_subnet "$1")
  base=${cidr%/*}; prefix=${cidr#*/}
  (( prefix <= 29 )) || die "internal subnet $cidr is too small"
  mask=$(( (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF ))
  net=$(( $(ip2int "$base") & mask ))
  bcast=$(( net | (~mask & 0xFFFFFFFF) ))
  int2ip $(( bcast - 1 ))
}

limit_args() { # prefix -> podman resource flags
  local p=$1
  [[ -n ${CFG[${p}_memory]} ]]     && printf -- '--memory=%s\n' "${CFG[${p}_memory]}"
  [[ -n ${CFG[${p}_cpus]} ]]       && printf -- '--cpus=%s\n' "${CFG[${p}_cpus]}"
  [[ -n ${CFG[${p}_pids_limit]} ]] && printf -- '--pids-limit=%s\n' "${CFG[${p}_pids_limit]}"
  return 0
}

mount_opt() { # extra options -> ",z" etc.
  local opts=$1
  [[ -n ${CFG[relabel]} ]] && opts+=",${CFG[relabel]}"
  printf '%s' "$opts"
}

# Remove every podman object labelled for the instance (and by name, in case
# a label is missing). Never touches the workspace.
remove_podman_objects() {
  local name=$1 ids
  ids=$(podman ps -a -q --filter "label=$LABEL_KEY=$name" 2>/dev/null || true)
  # shellcheck disable=SC2086
  [[ -n $ids ]] && podman rm -f -t 5 $ids >/dev/null
  local c; for c in "$(agent_ctr "$name")" "$(proxy_ctr "$name")"; do
    ctr_exists "$c" && podman rm -f -t 5 "$c" >/dev/null
  done
  ids=$(podman volume ls -q --filter "label=$LABEL_KEY=$name" 2>/dev/null || true)
  # shellcheck disable=SC2086
  [[ -n $ids ]] && podman volume rm -f $ids >/dev/null
  ids=$(podman network ls -q --filter "label=$LABEL_KEY=$name" 2>/dev/null || true)
  # shellcheck disable=SC2086
  [[ -n $ids ]] && podman network rm -f $ids >/dev/null
  # The instance image (and untagged earlier builds of it).
  ids=$(podman images -q --filter "label=$LABEL_KEY=$name" 2>/dev/null | sort -u || true)
  # shellcheck disable=SC2086
  [[ -n $ids ]] && { podman rmi -f $ids >/dev/null 2>&1 || warn "could not remove the image(s) of '$name'"; }
  return 0
}

# ------------------------------------------------------------ proxy config --

# Domains by source: "base", "tool" or "instance" ($2), for instance $1.
domains_from() {
  local f
  case $2 in
    base)     f=$(data_file domains.txt) || return 0 ;;
    tool)     f=$(data_file "tools/$(instance_tool "$1")/domains.txt") || return 0 ;;
    instance) f="$(instance_dir "$1")/domains.txt" ;;
  esac
  read_domains "$f"
}

allowed_domains() {
  local src
  for src in base tool instance; do domains_from "$1" "$src" || return 1; done
}

generate_proxy_config() {
  local name=$1 dir pdir ip subnet
  dir=$(instance_dir "$name"); pdir="$dir/proxy"
  mkdir -p "$pdir"; chmod 755 "$pdir"
  ip=$(proxy_ip "$name"); subnet=$(int_subnet "$name")

  local tool all
  tool=$(instance_tool "$name")
  all=$(allowed_domains "$name") || exit 1
  {
    printf '# generated by paddock: domains.txt + tools/%s/domains.txt + instances/%s/domains.txt\n' "$tool" "$name"
    printf '%s\n' "$all" | sed '/^$/d' | dedupe_domains
    # never empty: Squid rejects an empty dstdomain file
    printf 'paddock.invalid\n'
  } | atomic_write "$pdir/allowlist.txt" 0644

  if [[ -f $CONFIG_DIR/squid-extra.conf ]]; then
    atomic_write "$pdir/extra.conf" 0644 <"$CONFIG_DIR/squid-extra.conf"
  else
    rm -f "$pdir/extra.conf"
  fi

  atomic_write "$pdir/squid.conf" 0644 <<EOF
# generated by paddock for instance '$name' - do not edit, regenerated on start
# and on every 'paddock domains' change.

# Listen on the internal network only.
http_port $ip:$PROXY_PORT
icp_port 0
htcp_port 0

pid_filename /tmp/squid.pid
coredump_dir /tmp
cache deny all
cache_mem 8 MB
via off
forwarded_for delete
httpd_suppress_version_string on
shutdown_lifetime 1 seconds
logfile_rotate 0

logformat paddock paddock-access %{%Y-%m-%dT%H:%M:%S%z}tl %>a %rm %>rd %>rP %Ss %>Hs
access_log stdio:/dev/stdout paddock
cache_log /dev/stderr

acl agent_net src $subnet
acl allowlist dstdomain -n "/etc/paddock/allowlist.txt"
acl CONNECT method CONNECT
acl port_https port 443
acl port_http port 80
acl proto_http proto HTTP
# Loopback, "this network", RFC 1918, CGNAT, link-local, IETF/test/benchmark
# ranges, multicast/reserved; IPv6 loopback/unspecified, NAT64, ULA, link-local,
# documentation, multicast. No ::ffff:0:0/96: with IPv6 on, Squid stores IPv4
# addresses v4-mapped, so that entry equals 0.0.0.0/0 and would deny every IPv4
# destination. Mapped addresses are matched by the IPv4 entries instead.
acl forbidden_dst dst 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4
acl forbidden_dst dst ::/128 ::1/128 64:ff9b::/96 64:ff9b:1::/48 fc00::/7 fe80::/10 fec0::/10 2001:db8::/32 ff00::/8

http_access deny !agent_net
http_access deny !allowlist
http_access deny CONNECT !port_https
http_access deny !CONNECT !port_http
http_access deny !CONNECT !proto_http
http_access deny forbidden_dst
http_access allow agent_net
http_access deny all
$( [[ -f $pdir/extra.conf ]] && printf '\n# user additions from squid-extra.conf\ninclude /etc/paddock/extra.conf\n' )
EOF
}

reload_proxy() {
  local name=$1 pc
  pc=$(proxy_ctr "$name")
  generate_proxy_config "$name"
  if ctr_running "$pc"; then
    podman exec "$pc" squid -k parse -f /etc/paddock/squid.conf >/dev/null 2>&1 \
      || die "proxy rejected the new configuration; see 'podman exec $pc squid -k parse -f /etc/paddock/squid.conf'"
    local out
    out=$(podman exec "$pc" squid -k reconfigure -f /etc/paddock/squid.conf 2>&1) \
      || { printf '%s\n' "$out" >&2; die "failed to reload proxy $pc"; }
    info "proxy reloaded"
  fi
}

# Wait for this run's listening line. --since skips earlier runs' logs (the
# container keeps them across restarts). No grep -q: it exits on the first
# match, podman logs then dies of SIGPIPE, and pipefail fails the check.
wait_proxy_ready() {
  local pc=$1 ip=$2 since=$3
  for _ in $(seq 1 50); do
    ctr_running "$pc" || break
    if podman logs --since "$since" "$pc" 2>&1 \
        | grep "Accepting HTTP Socket connections at.*$ip:$PROXY_PORT" >/dev/null; then
      return 0
    fi
    sleep 0.2
  done
  podman logs --tail 20 "$pc" >&2 || true
  die "proxy $pc did not become ready"
}

# ------------------------------------------------------------------- git --

# git on the host runs commands from .git/config (core.fsmonitor, core.pager,
# filters, ...) and .git/hooks. Prints -v arguments that mount both read-only
# in the agent, so it can commit but not change what host git runs. .git
# itself is mounted too: a mount point cannot be renamed or replaced, so the
# agent cannot swap in a different .git. A .git file (worktree, submodule) is
# mounted read-only.
git_mount_args() { # ws
  local ws=$1 g="$1/.git"
  if [[ -L $g ]]; then
    warn "$g is a symlink; it is not protected"
  elif [[ -f $g ]]; then
    printf -- '-v\n%s:/workspace/.git:%s\n' "$g" "$(mount_opt ro,bind)"
  elif [[ -d $g ]]; then
    if [[ -L $g/config || -L $g/hooks || ! -f $g/config ]]; then
      warn "$g/config or $g/hooks is a symlink or missing; .git is not protected"
      return 0
    fi
    mkdir -p -- "$g/hooks"
    printf -- '-v\n%s:/workspace/.git:%s\n' "$g" "$(mount_opt bind)"
    printf -- '-v\n%s:/workspace/.git/config:%s\n' "$g/config" "$(mount_opt ro,bind)"
    printf -- '-v\n%s:/workspace/.git/hooks:%s\n' "$g/hooks" "$(mount_opt ro,bind)"
    # With extensions.worktreeConfig, git also reads .git/config.worktree.
    if git_worktree_config "$g"; then
      if [[ -L $g/config.worktree ]]; then
        warn "$g/config.worktree is a symlink; it is not protected"
      else
        [[ -e $g/config.worktree ]] || : >"$g/config.worktree"
        printf -- '-v\n%s:/workspace/.git/config.worktree:%s\n' "$g/config.worktree" "$(mount_opt ro,bind)"
      fi
    fi
  fi
}

# True if the repository config $1/config enables extensions.worktreeConfig.
# Parsed with grep: running host git on the workspace is what we guard against.
git_worktree_config() {
  grep -qiE '^[[:space:]]*worktreeconfig[[:space:]]*=[[:space:]]*(true|yes|on|1)[[:space:]]*$' "$1/config" 2>/dev/null
}

# Up to 5 nested .git entries (directories or files) below workspace $1,
# relative to it; a 6th line "..." if there are more. The top-level .git is
# skipped, and so is what lies inside any .git.
nested_git_dirs() {
  local ws=$1
  find "$ws" -mindepth 1 -name .git -prune -printf '%P\n' 2>/dev/null \
    | grep -vxF .git | awk 'NR <= 5 { print; next } { print "..."; exit }' || true
}

# --------------------------------------------------------- protected paths --

# The tool's protect_paths (tool.conf) are files and directories in the
# workspace that the tool run on the host reads and may run commands from,
# e.g. hooks in Claude Code's .claude/settings.json. They are mounted
# read-only in the agent. An entry with a trailing / is a directory, created
# if missing; a file entry is protected only if it exists. Needs load_tool.

# Prints -v arguments for the protected paths of workspace $1.
protect_mount_args() { # ws
  local ws=$1 e p
  for e in ${TOOL[protect_paths]}; do
    p=${e%/}
    if [[ -L $ws/$p ]]; then
      warn "$ws/$p is a symlink; it is not protected"; continue
    fi
    if [[ ! -e $ws/$p ]]; then
      [[ $e == */ ]] || continue
      mkdir -- "$ws/$p"
    fi
    printf -- '-v\n%s:/workspace/%s:%s\n' "$ws/$p" "$p" "$(mount_opt ro,bind)"
  done
}

# Names (comma-separated) of the protected paths among -v arguments on stdin.
protected_names() {
  sed -n 's|^.*:/workspace/\([^/:]*\):.*$|\1|p' | grep -vxF .git | paste -sd, || true
}

# Before instance $1's agent starts: re-create missing protected directories
# (podman cannot start with a missing bind source) and refuse a missing file.
# Warn about protected paths that exist but are not mounted read-only. With
# $3 = warn-only (stop), only warn.
protect_check() { # name ws [warn-only]
  local name=$1 ws=$2 mode=${3-} e p label
  label=$(podman container inspect --format '{{index .Config.Labels "paddock.protected"}}' "$(agent_ctr "$name")" 2>/dev/null || true)
  for e in ${TOOL[protect_paths]}; do
    p=${e%/}
    if [[ ,$label, == *",$p,"* ]]; then
      if [[ ! -e $ws/$p && ! -L $ws/$p && $mode != warn-only ]]; then
        [[ $e == */ ]] || die "$ws/$p was removed; run 'paddock recreate $name'"
        mkdir -- "$ws/$p"
      fi
    elif [[ -e $ws/$p || -L $ws/$p ]]; then
      warn "$ws/$p is not mounted read-only in '$name' (created after the instance?); ${TOOL[command]} on the host may run commands from it. Check it, then run 'paddock recreate $name' to protect it"
    fi
  done
  return 0
}

# Warnings about git state in workspace $2 that the mounts cannot cover: git
# on the host would run commands configured there (core.fsmonitor, hooks, ...).
git_warnings() { # name ws
  local name=$1 ws=$2 g="$2/.git" label d nested
  # Nested repositories (also submodule checkouts, whose .git is a file the
  # agent can point anywhere). `git status` or `git add` in the workspace runs
  # git in each submodule the index lists, with that repository's config.
  nested=$(nested_git_dirs "$ws" | paste -sd' ')
  if [[ -n $nested ]]; then
    warn "nested git repositories in $ws ($nested): their config and hooks are writable by the agent, and git on the host runs them, also from 'git status' in $ws. See 'Git' in the paddock README before using git there"
  fi
  [[ -e $g || -L $g ]] || return 0
  label=$(podman container inspect --format '{{index .Config.Labels "paddock.git"}}' "$(agent_ctr "$name")" 2>/dev/null || true)
  if [[ $label != protected ]]; then
    warn "$g is not mounted read-only in '$name' (created after the instance?); run 'paddock recreate $name' to protect it"
  fi
  [[ -d $g ]] || return 0
  # git reads config and hooks from the directory named in commondir.
  if [[ -e $g/commondir ]]; then
    warn "$g/commondir exists; git on the host reads config and hooks from the directory it names. Check it before using git there"
  fi
  # Submodule repositories keep their own config and hooks here.
  if [[ -n $(find "$g/modules" -name config -type f -print -quit 2>/dev/null) ]]; then
    warn "$g/modules has submodule repositories; their config and hooks are writable by the agent. Check them before using git on the host"
  fi
  # A linked worktree's commondir normally names this .git ("../.."); its
  # config.worktree is read when extensions.worktreeConfig is on.
  for d in "$g"/worktrees/*/; do
    if [[ -e $d/commondir && $(cat "$d/commondir" 2>/dev/null) != ../.. ]]; then
      warn "${d%/}/commondir names another directory; git in that worktree reads config and hooks from there"
    fi
    if [[ -e $d/config.worktree ]] && git_worktree_config "$g"; then
      warn "${d%/}/config.worktree is writable by the agent; check it before using git in that worktree"
    fi
  done
  if git_worktree_config "$g"; then
    label=$(podman container inspect --format '{{index .Config.Labels "paddock.git-worktree-config"}}' "$(agent_ctr "$name")" 2>/dev/null || true)
    [[ $label == protected ]] \
      || warn "$g/config.worktree is not mounted read-only in '$name' (extensions.worktreeConfig set after the instance?); run 'paddock recreate $name'"
  fi
  return 0
}

# ------------------------------------------------------------- containers --

create_containers() {
  local name=$1 ws ip uid gid tool envf img
  local -a pkgs
  tool=$(instance_tool "$name")
  load_packages "$name" pkgs
  img=$(instance_image "$name")
  podman image exists "$img" || die "image $img not found; run 'paddock recreate $name'"
  ws=$(verify_workspace "$name")
  ip=$(proxy_ip "$name")
  uid=$(id -u); gid=$(id -g)
  generate_proxy_config "$name"

  local -a common=(
    --label "$LABEL_KEY=$name"
    --userns=keep-id --user "$uid:$gid"
    --cap-drop=ALL
    --security-opt=no-new-privileges
  )
  local -a plimits alimits
  mapfile -t plimits < <(limit_args proxy)
  mapfile -t alimits < <(limit_args agent)

  podman create --name "$(proxy_ctr "$name")" "${common[@]}" "${plimits[@]}" \
    --hostname "$(proxy_ctr "$name")" \
    --network "$(int_net "$name"):ip=$ip" \
    --network "$(ext_net "$name")" \
    --read-only --tmpfs /tmp:rw,mode=1777,size=64m \
    -v "$(instance_dir "$name")/proxy:/etc/paddock:$(mount_opt ro)" \
    "$PROXY_IMAGE" >/dev/null

  local -a tenv=() gitv=()
  if envf=$(data_file "tools/$tool/env"); then tenv=(--env-file "$envf"); fi
  mapfile -t gitv < <(git_mount_args "$ws")
  local -a protv=()
  load_tool "$tool"
  mapfile -t protv < <(protect_mount_args "$ws")
  protv+=(--label "paddock.protected=$(printf '%s\n' "${protv[@]}" | protected_names)")
  ((${#gitv[@]})) && gitv+=(--label paddock.git=protected)
  [[ " ${gitv[*]} " == *":/workspace/.git/config.worktree:"* ]] && gitv+=(--label paddock.git-worktree-config=protected)
  local purl
  purl="http://$(proxy_ctr "$name"):$PROXY_PORT"
  podman create --name "$(agent_ctr "$name")" "${common[@]}" "${alimits[@]}" \
    --label "paddock.tool=$tool" \
    --label "paddock.packages=$(IFS=,; printf '%s' "${pkgs[*]}")" \
    --hostname "$name" \
    --network "$(int_net "$name")" \
    --dns=none \
    --add-host "$(proxy_ctr "$name"):$ip" \
    --init \
    -v "$(home_vol "$name"):/home/agent:U" \
    -v "$ws:/workspace:$(mount_opt bind)" \
    "${gitv[@]}" \
    "${protv[@]}" \
    -w /workspace \
    -e HOME=/home/agent \
    -e HTTPS_PROXY="$purl" -e https_proxy="$purl" \
    -e HTTP_PROXY="$purl"  -e http_proxy="$purl" \
    -e NO_PROXY=localhost,127.0.0.1 -e no_proxy=localhost,127.0.0.1 \
    "${tenv[@]}" \
    -e PADDOCK_INSTANCE="$name" -e PADDOCK_TOOL="$tool" \
    "$img" sleep infinity >/dev/null
}

create_networks_and_volume() {
  local name=$1
  podman network create --internal --disable-dns -o isolate=true \
    --label "$LABEL_KEY=$name" "$(int_net "$name")" >/dev/null
  podman network create -o isolate=true \
    --label "$LABEL_KEY=$name" "$(ext_net "$name")" >/dev/null
  podman volume exists "$(home_vol "$name")" \
    || podman volume create --label "$LABEL_KEY=$name" "$(home_vol "$name")" >/dev/null
}

start_instance() {
  local name=$1 pc ac
  pc=$(proxy_ctr "$name"); ac=$(agent_ctr "$name")
  { ctr_exists "$pc" && ctr_exists "$ac"; } || die "containers for '$name' are missing; run 'paddock recreate $name'"
  local ws; ws=$(verify_workspace "$name")
  git_warnings "$name" "$ws"
  load_tool "$(instance_tool "$name")"
  protect_check "$name" "$ws"
  packages_warning "$name"
  if ! ctr_running "$pc"; then
    generate_proxy_config "$name"
    local since; since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    podman start "$pc" >/dev/null
    wait_proxy_ready "$pc" "$(proxy_ip "$name")" "$since"
  fi
  ctr_running "$ac" || podman start "$ac" >/dev/null
}

# Warn if instance $1's packages changed since its containers were created.
packages_warning() {
  local -a pkgs
  load_packages "$1" pkgs
  [[ $(object_label "$(agent_ctr "$1")" paddock.packages) == "$(IFS=,; printf '%s' "${pkgs[*]}")" ]] \
    || warn "the packages of '$1' changed; run 'paddock recreate $1' to use them"
}

# Sets TTY_FLAG for podman exec. Not a $(...) helper: inside command
# substitution stdout is a pipe, so [[ -t 1 ]] would always be false.
set_tty_flag() { if [[ -t 0 && -t 1 ]]; then TTY_FLAG=-it; else TTY_FLAG=-i; fi; }

# Prints -e args that pass the host terminal's TERM and COLORTERM to an
# interactive exec session. Without them the session gets podman's default
# TERM=xterm and no COLORTERM, and Claude Code drops to 16 colors (its orange
# turns red). A TERM the agent image has no terminfo for is replaced by
# xterm-256color, since bash and less misbehave with an unknown TERM.
term_env_args() {
  local ctr=$1 term=${TERM-} colorterm=${COLORTERM-}
  [[ $TTY_FLAG == -it ]] || return 0
  if [[ $term =~ ^[A-Za-z0-9._+-]+$ && $term != dumb ]]; then
    podman exec "$ctr" infocmp -- "$term" >/dev/null 2>&1 || term=xterm-256color
    printf -- '-e\nTERM=%s\n' "$term"
  fi
  if [[ $colorterm =~ ^[A-Za-z0-9._+-]+$ ]]; then printf -- '-e\nCOLORTERM=%s\n' "$colorterm"; fi
}

# --------------------------------------------------------------- commands --

cmd_create() {
  local tool="" name="" path="" domains_csv="" packages_csv=""
  while (($#)); do
    case $1 in
      --no-agents-md) warn "--no-agents-md is no longer needed: paddock does not write AGENTS.md into workspaces"; shift ;;
      --domains) (($# >= 2)) || die "--domains needs a value"; domains_csv=$2; shift 2 ;;
      --domains=*) domains_csv=${1#*=}; shift ;;
      --packages) (($# >= 2)) || die "--packages needs a value"; packages_csv=$2; shift 2 ;;
      --packages=*) packages_csv=${1#*=}; shift ;;
      -*) die "unknown option '$1'" ;;
      *) if [[ -z $tool ]]; then tool=$1; elif [[ -z $name ]]; then name=$1
         elif [[ -z $path ]]; then path=$1; else die "unexpected argument '$1'"; fi; shift ;;
    esac
  done
  [[ -n $tool && -n $name && -n $path ]] || die "usage: paddock create <tool> <name> <path> [--domains d1,d2,...] [--packages p1,p2,...]"
  load_tool "$tool"
  validate_name "$name"
  local dir; dir=$(instance_dir "$name")
  [[ -e $dir ]] && die "instance '$name' already exists"
  if podman ps -a -q --filter "label=$LABEL_KEY=$name" | grep -q . \
     || podman network exists "$(int_net "$name")" || podman network exists "$(ext_net "$name")"; then
    die "podman objects for '$name' already exist; remove them or use 'paddock rm $name --force'"
  fi

  local -a domains=()
  local d
  if [[ -n $domains_csv ]]; then
    IFS=, read -r -a parts <<<"$domains_csv"
    for d in "${parts[@]}"; do
      d=${d//[[:space:]]/}; [[ -z $d ]] && continue
      domains+=("$(normalize_domain "$d")")
    done
  fi
  local -a packages=()
  if [[ -n $packages_csv ]]; then
    IFS=, read -r -a parts <<<"$packages_csv"
    for d in "${parts[@]}"; do
      d=${d//[[:space:]]/}; [[ -z $d ]] && continue
      validate_package "$d"; packages+=("$d")
    done
  fi

  require_images "$tool"

  # Podman's storage (images, containers, volumes) must not be a workspace.
  local -a store
  mapfile -t store < <(podman info --format '{{.Store.GraphRoot}}{{"\n"}}{{.Store.VolumePath}}' 2>/dev/null | sed '/^$/d')
  local ws
  ws=$(check_workspace_path "$path" "${store[@]}")
  [[ -e $ws && ! -d $ws ]] && die "$ws exists and is not a directory"
  check_workspace_overlap "$name" "$ws"
  mkdir -p -- "$ws"
  ws=$(check_workspace_path "$(realpath -e -- "$ws")" "${store[@]}")   # re-check after symlink resolution
  check_workspace_overlap "$name" "$ws"

  # Roll back everything on failure.
  trap 'rc=$?; if ((rc)); then warn "create failed, rolling back"; remove_podman_objects "'"$name"'"; rm -rf -- "'"$dir"'"; fi' EXIT
  mkdir -p "$dir"
  printf '%s\n' "$ws" | atomic_write "$dir/workspace" 0644
  printf '%s\n' "$tool" | atomic_write "$dir/tool" 0644
  { printf '# extra domains for instance %s (example.com or .example.com)\n' "$name"
    if ((${#domains[@]})); then printf '%s\n' "${domains[@]}" | sort -u; fi
  } | atomic_write "$dir/domains.txt" 0644
  if ((${#packages[@]})); then printf '%s\n' "${packages[@]}"; fi | write_instance_packages "$name"

  local -a pkgs; load_packages "$name" pkgs
  build_inst_image "$name" "${pkgs[@]}" || die "could not build the image for '$name' (unknown package?)"
  create_networks_and_volume "$name"
  create_containers "$name"
  trap - EXIT
  info "created $tool instance '$name' (workspace $ws). Start it with: paddock start $name"
}

cmd_recreate() {
  (($# == 1)) || die "usage: paddock recreate <name>"
  local name=$1 tool; require_instance "$name"
  tool=$(instance_tool "$name"); load_tool "$tool"; require_images "$tool"
  # Check and build before removing anything, so a refusal or a failed build
  # leaves the instance as it was.
  verify_workspace "$name" >/dev/null
  local -a pkgs; load_packages "$name" pkgs
  build_inst_image "$name" "${pkgs[@]}" \
    || die "could not build the image for '$name'; instance unchanged (fix with 'paddock packages $name edit')"
  local c old=""
  old=$(podman container inspect --format '{{.Image}}' "$(agent_ctr "$name")" 2>/dev/null) || old=""
  for c in "$(agent_ctr "$name")" "$(proxy_ctr "$name")"; do
    ctr_exists "$c" && podman rm -f -t 5 "$c" >/dev/null
  done
  if ! { podman network exists "$(int_net "$name")" && podman network exists "$(ext_net "$name")"; }; then
    local n
    for n in "$(int_net "$name")" "$(ext_net "$name")"; do
      if podman network exists "$n"; then podman network rm -f "$n" >/dev/null; fi
    done
    create_networks_and_volume "$name"
  fi
  podman volume exists "$(home_vol "$name")" \
    || podman volume create --label "$LABEL_KEY=$name" "$(home_vol "$name")" >/dev/null
  create_containers "$name"
  # Images the instance no longer uses: the instance image once it has no
  # packages, and the untagged previous build.
  if ((${#pkgs[@]} == 0)) && podman image exists "$(inst_image "$name")"; then
    podman rmi "$(inst_image "$name")" >/dev/null 2>&1 || true
  fi
  rm_dangling_inst_image "$old"
  info "recreated containers for '$name' with $(instance_image "$name") (home volume kept)"
}

cmd_start() {
  (($# == 1)) || die "usage: paddock start <name>"
  require_instance "$1"
  start_instance "$1"
  info "instance '$1' is running"
}

cmd_stop() {
  (($# == 1)) || die "usage: paddock stop <name>"
  local name=$1 c; require_instance "$name"
  for c in "$(agent_ctr "$name")" "$(proxy_ctr "$name")"; do
    ctr_exists "$c" && podman stop -t 5 "$c" >/dev/null
  done
  if [[ -f $(instance_dir "$name")/workspace ]]; then
    local ws; ws=$(<"$(instance_dir "$name")/workspace")
    git_warnings "$name" "$ws"
    load_tool "$(instance_tool "$name")"
    protect_check "$name" "$ws" warn-only
  fi
  info "instance '$name' stopped"
}

cmd_attach() {
  local name="" yolo=0
  local -a cargs=()
  while (($#)); do
    case $1 in
      --yolo) yolo=1; shift ;;
      --) shift; cargs=("$@"); break ;;
      -*) die "unknown option '$1' (pass tool arguments after --)" ;;
      *) [[ -z $name ]] || die "unexpected argument '$1'"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || die "usage: paddock attach <name> [--yolo] [-- tool args]"
  require_instance "$name"
  load_tool "$(instance_tool "$name")"
  if ((yolo)); then
    [[ -n ${TOOL[yolo_args]} ]] || die "tool '${TOOL[name]}' has no --yolo mode (yolo_args is empty)"
    local -a yargs; read -r -a yargs <<<"${TOOL[yolo_args]}"
    start_instance "$name"
    printf '\033[1;31mWARNING:\033[0m --yolo runs %s with %s.\n' "${TOOL[command]}" "${TOOL[yolo_args]}" >&2
    printf 'It will run commands and edit files in %s without asking.\n' "$(<"$(instance_dir "$name")/workspace")" >&2
    cargs=("${yargs[@]}" "${cargs[@]}")
  else
    start_instance "$name"
  fi
  local TTY_FLAG; set_tty_flag
  local -a tenvs; mapfile -t tenvs < <(term_env_args "$(agent_ctr "$name")")
  exec podman exec "$TTY_FLAG" -w /workspace "${tenvs[@]}" "$(agent_ctr "$name")" "${TOOL[command]}" "${cargs[@]}"
}

cmd_shell() {
  (($# == 1)) || die "usage: paddock shell <name>"
  require_instance "$1"
  start_instance "$1"
  local TTY_FLAG; set_tty_flag
  local -a tenvs; mapfile -t tenvs < <(term_env_args "$(agent_ctr "$1")")
  exec podman exec "$TTY_FLAG" -w /workspace "${tenvs[@]}" "$(agent_ctr "$1")" bash
}

cmd_rm() {
  local name="" force=0
  while (($#)); do
    case $1 in
      -f|--force) force=1 ;;
      -*) die "unknown option '$1'" ;;
      *) [[ -z $name ]] || die "unexpected argument '$1'"; name=$1 ;;
    esac
    shift
  done
  [[ -n $name ]] || die "usage: paddock rm <name> [--force]"
  validate_name "$name"
  local dir ws="(unknown)"; dir=$(instance_dir "$name")
  if [[ ! -d $dir ]] && ! podman ps -a -q --filter "label=$LABEL_KEY=$name" | grep -q . \
     && ! podman network ls -q --filter "label=$LABEL_KEY=$name" | grep -q .; then
    die "no such instance '$name'"
  fi
  [[ -f $dir/workspace ]] && ws=$(<"$dir/workspace")
  if ((!force)); then
    confirm "Remove instance '$name' (containers, networks, home volume incl. login, config)? Workspace $ws is kept." \
      || die "aborted"
  fi
  remove_podman_objects "$name"
  rm -rf -- "$dir"
  info "removed instance '$name' (workspace $ws untouched)"
}

cmd_list() {
  (($# == 0)) || die "usage: paddock list"
  local dir name ws state a p n np tool
  printf '%-32s %-10s %-10s %-7s %-5s %s\n' NAME STATE TOOL DOMAINS PKGS WORKSPACE
  for dir in "$INSTANCES_DIR"/*/; do
    name=$(basename "$dir")
    [[ $name =~ $NAME_RE ]] || continue
    ws=$(cat "$dir/workspace" 2>/dev/null || echo '?')
    a=$(ctr_state "$(agent_ctr "$name")"); p=$(ctr_state "$(proxy_ctr "$name")")
    if [[ $a == "$p" ]]; then state=$a
    elif [[ $a == running || $p == running ]]; then state=partial
    else state=$a; fi
    tool=$(cat "$dir/tool" 2>/dev/null || echo '?')
    n=$(read_domains "$dir/domains.txt" 2>/dev/null | grep -c . || true)
    np=$(read_packages "$dir/packages.txt" 2>/dev/null | sort -u | grep -c . || true)
    printf '%-32s %-10s %-10s %-7s %-5s %s\n' "$name" "$state" "$tool" "$n" "$np" "$ws"
  done
}

write_instance_domains() { # name, domains on stdin
  local f; f="$(instance_dir "$1")/domains.txt"
  { printf '# extra domains for instance %s (example.com or .example.com)\n' "$1"; sort -u | grep . || true; } \
    | atomic_write "$f" 0644
}

cmd_domains() {
  (($# >= 2)) || die "usage: paddock domains <name> list|add|rm|edit [domain...]"
  local name=$1 sub=$2; shift 2
  require_instance "$name"
  local f; f="$(instance_dir "$name")/domains.txt"
  local cur d
  case $sub in
    list)
      (($# == 0)) || die "usage: paddock domains <name> list"
      local src
      for src in base tool instance; do
        domains_from "$name" "$src" | sort -u | sed "s/^/$(printf '%-9s ' "$src")/"
      done
      ;;
    add|rm)
      (($#)) || die "usage: paddock domains <name> $sub <domain>..."
      local -a given=()
      for d in "$@"; do given+=("$(normalize_domain "$d")"); done
      cur=$(read_domains "$f") || exit 1
      if [[ $sub == add ]]; then
        { [[ -n $cur ]] && printf '%s\n' "$cur"; printf '%s\n' "${given[@]}"; } | write_instance_domains "$name"
      else
        for d in "${given[@]}"; do
          grep -qxF -- "$d" <<<"$cur" || warn "$d is not in the instance allowlist"
          if domains_from "$name" base | grep -qxF -- "$d"; then
            warn "$d is allowed for all instances (domains.txt); override $CONFIG_DIR/domains.txt to remove it"
          elif domains_from "$name" tool | grep -qxF -- "$d"; then
            warn "$d is allowed for all $(instance_tool "$name") instances; override $CONFIG_DIR/tools/$(instance_tool "$name")/domains.txt to remove it"
          fi
        done
        { printf '%s\n' "$cur" | grep -vxF -f <(printf '%s\n' "${given[@]}") || true; } | write_instance_domains "$name"
      fi
      reload_proxy "$name"
      ;;
    edit)
      (($# == 0)) || die "usage: paddock domains <name> edit"
      have_tty || die "domains edit needs a terminal; use 'domains $name add|rm' instead"
      local tmp; tmp=$(mktemp --suffix=.txt)
      # shellcheck disable=SC2064
      trap "rm -f '$tmp'" EXIT
      cp "$f" "$tmp"
      while :; do
        ${EDITOR:-${VISUAL:-vi}} "$tmp" </dev/tty >/dev/tty || die "editor failed"
        if cur=$(read_domains "$tmp"); then break; fi
        confirm "Invalid allowlist. Edit again?" || die "aborted; allowlist unchanged"
      done
      printf '%s\n' "$cur" | write_instance_domains "$name"
      reload_proxy "$name"
      ;;
    *) die "unknown domains subcommand '$sub' (list|add|rm|edit)" ;;
  esac
}

write_instance_packages() { # name, packages on stdin
  local f; f="$(instance_dir "$1")/packages.txt"
  { printf '# extra pacman packages for instance %s, built into its own image\n' "$1"; sort -u | grep . || true; } \
    | atomic_write "$f" 0644
}

# Build the image for instance $1's new package list (stdin), then save the
# list. A failed build (e.g. an unknown package) leaves the list unchanged.
set_instance_packages() {
  local name=$1 list
  local -a cur new=()
  list=$(sort -u | grep . || true)
  [[ -z $list ]] || mapfile -t new <<<"$list"
  load_packages "$name" cur
  if [[ "${new[*]}" == "${cur[*]}" ]]; then info "packages of '$name' unchanged"; return 0; fi
  local tool; tool=$(instance_tool "$name"); load_tool "$tool"; require_images "$tool"
  build_inst_image "$name" "${new[@]}" \
    || die "could not build the image for '$name' (unknown package?); package list unchanged"
  printf '%s\n' "$list" | write_instance_packages "$name"
  if ctr_exists "$(agent_ctr "$name")"; then
    info "packages of '$name' saved; run 'paddock recreate $name' to use them (ends sessions in the instance; home volume and workspace are kept)"
  fi
}

cmd_packages() {
  (($# >= 2)) || die "usage: paddock packages <name> list|add|rm|edit [package...]"
  local name=$1 sub=$2; shift 2
  require_instance "$name"
  local f; f="$(instance_dir "$name")/packages.txt"
  local -a cur
  local p
  case $sub in
    list)
      (($# == 0)) || die "usage: paddock packages <name> list"
      load_packages "$name" cur
      ((${#cur[@]} == 0)) || printf '%s\n' "${cur[@]}"
      ;;
    add|rm)
      (($#)) || die "usage: paddock packages <name> $sub <package>..."
      for p in "$@"; do validate_package "$p"; done
      load_packages "$name" cur
      if [[ $sub == add ]]; then
        printf '%s\n' "${cur[@]}" "$@" | set_instance_packages "$name"
      else
        for p in "$@"; do
          printf '%s\n' "${cur[@]}" | grep -qxF -- "$p" || warn "$p is not in the package list of '$name'"
        done
        { printf '%s\n' "${cur[@]}" | grep -vxF -f <(printf '%s\n' "$@") || true; } | set_instance_packages "$name"
      fi
      ;;
    edit)
      (($# == 0)) || die "usage: paddock packages <name> edit"
      have_tty || die "packages edit needs a terminal; use 'packages $name add|rm' instead"
      local tmp list; tmp=$(mktemp --suffix=.txt)
      # shellcheck disable=SC2064
      trap "rm -f '$tmp'" EXIT
      if [[ -f $f ]]; then cp "$f" "$tmp"
      else printf '# extra pacman packages for instance %s, built into its own image\n' "$name" >"$tmp"; fi
      while :; do
        ${EDITOR:-${VISUAL:-vi}} "$tmp" </dev/tty >/dev/tty || die "editor failed"
        if list=$(read_packages "$tmp"); then break; fi
        confirm "Invalid package list. Edit again?" || die "aborted; package list unchanged"
      done
      printf '%s\n' "$list" | set_instance_packages "$name"
      ;;
    *) die "unknown packages subcommand '$sub' (list|add|rm|edit)" ;;
  esac
}

cmd_logs() {
  local name="" follow=0 raw=0 tail=""
  while (($#)); do
    case $1 in
      -f|--follow) follow=1; shift ;;
      --raw) raw=1; shift ;;
      -n|--tail) (($# >= 2)) || die "$1 needs a value"; tail=$2; shift 2 ;;
      --tail=*) tail=${1#*=}; shift ;;
      -*) die "unknown option '$1'" ;;
      *) [[ -z $name ]] || die "unexpected argument '$1'"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || die "usage: paddock logs <name> [-f] [-n N] [--raw]"
  [[ -z $tail || $tail =~ ^[1-9][0-9]{0,8}$ ]] || die "-n needs a positive number, not '$tail'"
  require_instance "$name"
  local pc; pc=$(proxy_ctr "$name")
  ctr_exists "$pc" || die "proxy container $pc does not exist"
  local -a args=()
  ((follow)) && args+=(--follow)
  if ((raw)); then
    [[ -n $tail ]] && args+=(--tail "$tail")
    exec podman logs "${args[@]}" "$pc"
  fi
  podman logs "${args[@]}" "$pc" 2>&1 | awk -v tail="$tail" '
    $1 == "paddock-access" {
      verdict = ($7 ~ /DENIED/) ? "DENIED " : "ALLOWED"
      line = sprintf("%s %s %-7s %s:%s (%s %s)", $2, verdict, $4, $5, $6, $7, $8)
      if (tail == "") { print line; fflush() } else { buf[n++ % tail] = line }
    }
    END { if (tail != "") for (i = (n > tail ? n - tail : 0); i < n; i++) print buf[i % tail] }'
}

cmd_build() {
  local tool="" version="" refresh=0
  while (($#)); do
    case $1 in
      --refresh) refresh=1; shift ;;
      --version) (($# >= 2)) || die "--version needs a value"; version=$2; shift 2 ;;
      --version=*) version=${1#*=}; shift ;;
      -*) die "unknown option '$1'" ;;
      *) [[ -z $tool ]] || die "unexpected argument '$1'"; tool=$1; shift ;;
    esac
  done
  [[ -n $tool ]] || die "usage: paddock build <tool> [--version X] [--refresh] (tools: $(list_tools | paste -sd' '))"
  load_tool "$tool"
  if [[ -z $version ]]; then
    [[ -n ${TOOL[npm_package]} ]] || die "tool '$tool' has no npm_package to resolve the latest version from; pass --version X"
    need_cmd curl
    info "resolving latest ${TOOL[npm_package]} version from the npm registry"
    version=$(curl -fsSL "https://registry.npmjs.org/${TOOL[npm_package]}/latest" \
              | grep -o '"version":"[^"]*"' | head -n1 | cut -d'"' -f4) \
      || die "could not resolve the latest version; pass --version X"
  fi
  [[ $version =~ $VERSION_RE ]] || die "invalid version '$version' (expected e.g. 2.1.0)"

  local ctx f src
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$ctx'" EXIT
  # Optional extra build-context files (e.g. a corporate CA) live in build/.
  if [[ -d $CONFIG_DIR/build ]]; then cp -a "$CONFIG_DIR/build/." "$ctx/"; fi
  for f in Containerfile.proxy Containerfile.base PADDOCK.md "tools/$tool/Containerfile"; do
    src=$(data_file "$f") || die "$f not found in $CONFIG_DIR or $DATA_DIR"
    cp "$src" "$ctx/${f//\//_}"
  done

  # Cached layers keep the packages of their first build until the Arch image
  # itself changes; --refresh rebuilds every layer to get current packages.
  local -a nocache=()
  ((refresh)) && nocache=(--no-cache)
  local img="$AGENT_IMAGE_PREFIX$tool:$version"
  info "building $PROXY_IMAGE"
  podman build --pull=newer "${nocache[@]}" -t "$PROXY_IMAGE" -f "$ctx/Containerfile.proxy" "$ctx"
  info "building $BASE_IMAGE"
  podman build --pull=newer "${nocache[@]}" -t "$BASE_IMAGE" -f "$ctx/Containerfile.base" "$ctx"
  info "building $img"
  podman build --pull=never "${nocache[@]}" -t "$img" --build-arg "PADDOCK_BASE=$BASE_IMAGE" \
    --build-arg "TOOL_VERSION=$version" -f "$ctx/tools_${tool}_Containerfile" "$ctx"
  local old; old=$(tool_version "$tool")
  set_tool_version "$tool" "$version"
  info "$tool image is now $img"
  if [[ -n $old && $old != "$version" ]] && grep -qsxF "$tool" "$INSTANCES_DIR"/*/tool; then
    info "existing $tool instances still use $AGENT_IMAGE_PREFIX$tool:$old; run 'paddock recreate <name>' to switch (login is kept)"
  elif ((refresh)) && grep -qsxF "$tool" "$INSTANCES_DIR"/*/tool; then
    info "existing $tool instances keep the previous image until 'paddock recreate <name>' (login is kept)"
  fi
}

cmd_tools() {
  (($# == 0)) || die "usage: paddock tools"
  local t v src
  printf '%-12s %-12s %s\n' TOOL IMAGE DEFINITION
  while IFS= read -r t; do
    v=$(tool_version "$t"); src=$(data_file "tools/$t/tool.conf")
    printf '%-12s %-12s %s\n' "$t" "${v:-(not built)}" "$(dirname "$src")"
  done < <(list_tools)
}

# ------------------------------------------------------------------ purge --

# Names of all paddock instances: configured ones plus any whose podman
# objects are left over without a config.
all_instance_names() {
  local d
  for d in "$INSTANCES_DIR"/*/; do basename "$d"; done
  {
    # Names, not label values: some podman versions cannot index .Labels here.
    podman ps -a --filter "label=$LABEL_KEY" --format '{{.Names}}' | sed -nE 's/^pd-(.+)-(agent|proxy)$/\1/p'
    podman volume ls --filter "label=$LABEL_KEY" --format '{{.Name}}' | sed -nE 's/^pd-(.+)-home$/\1/p'
    # Network labels cannot be indexed in every podman version; use the name.
    podman network ls --filter "label=$LABEL_KEY" --format '{{.Name}}' | sed -nE 's/^pd-(.+)-(int|ext)$/\1/p'
  } 2>/dev/null
}

# paddock images: instance images first, then tool images, and last the base
# they all build on (and the proxy).
paddock_images() {
  # Exact prefix match: podman's reference filter would also match e.g.
  # localhost/my-paddock-x.
  podman images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | sort -u \
    | awk -v pre="$AGENT_IMAGE_PREFIX" -v inst="$INST_IMAGE_REPO:" -v b="$BASE_IMAGE" -v p="$PROXY_IMAGE" '
        index($0, pre) != 1 || /<none>/ { next }
        index($0, inst) == 1 { print; next }
        $0 == b || $0 == p { last = last $0 "\n"; next }
        { mid = mid $0 "\n" }
        END { printf "%s%s", mid, last }'
}

# Removes everything paddock created for this user: all instances (containers,
# networks, home volumes), the paddock images and the config dir. Workspaces
# are never touched. Meant to run before uninstalling paddock.
cmd_purge() {
  local force=0 keep_images=0 a
  for a; do
    case $a in
      -f|--force) force=1 ;;
      --keep-images) keep_images=1 ;;
      *) die "usage: paddock purge [--force] [--keep-images]" ;;
    esac
  done
  local -a names=() images=()
  if command -v podman >/dev/null 2>&1; then
    mapfile -t names < <(all_instance_names | grep -E "$NAME_RE" | sort -u)
    ((keep_images)) || mapfile -t images < <(paddock_images)
  else
    warn "podman not found; only removing the config dir"
    local d; for d in "$INSTANCES_DIR"/*/; do names+=("$(basename "$d")"); done
  fi

  if ((${#names[@]} == 0 && ${#images[@]} == 0)) && [[ ! -e $CONFIG_DIR ]]; then
    info "nothing to purge"; return 0
  fi
  {
    echo "paddock purge removes:"
    local n ws
    for n in "${names[@]}"; do
      if ws=$(cat "$INSTANCES_DIR/$n/workspace" 2>/dev/null); then ws="workspace $ws is kept"
      else ws="no config left"; fi
      printf '  instance %-20s containers, networks, home volume (login); %s\n' "$n" "$ws"
    done
    for n in "${images[@]}"; do printf '  image    %s\n' "$n"; done
    [[ -e $CONFIG_DIR ]] && printf '  config   %s (settings, overrides, instance definitions)\n' "$CONFIG_DIR"
  } >&2
  if ((!force)); then
    confirm "Remove all of this? This cannot be undone." || die "aborted"
  fi

  for n in "${names[@]}"; do remove_podman_objects "$n"; info "removed instance '$n'"; done
  for n in "${images[@]}"; do
    podman image exists "$n" || continue   # an instance image, removed with its instance
    if podman rmi "$n" >/dev/null 2>&1; then info "removed image $n"
    else warn "could not remove image $n (still used by a container?)"; fi
  done
  if [[ -e $CONFIG_DIR ]]; then rm -rf -- "$CONFIG_DIR"; info "removed $CONFIG_DIR"; fi
  info "purge done; workspaces were not touched"
}

# ----------------------------------------------------------------- doctor --

# os_release KEY: value of KEY in /etc/os-release (empty if unset).
os_release() {
  [[ -r /etc/os-release ]] || return 0
  # shellcheck disable=SC1091
  (. /etc/os-release && printf '%s' "${!1-}")
}

# version_ge A B: true if dotted version A >= B.
version_ge() { [[ $(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1) == "$2" ]]; }

readonly PODMAN_MIN=4.4.0
readonly PODMAN_DOCS=https://podman.io/docs/installation

# Checks the host for what paddock needs and prints a fix for each problem.
# Exit status 1 if anything required is missing; warnings do not fail.
cmd_doctor() {
  (($# == 0)) || die "usage: paddock doctor"
  local nfail=0 nwarn=0 user v info="" backend rootless cgv ctrls c missing=""
  ok()   { printf '  ok    %s\n' "$1"; }
  bad()  { nfail=$((nfail + 1)); printf '  FAIL  %s\n' "$1"; shift; local l; for l; do printf '        %s\n' "$l"; done; }
  meh()  { nwarn=$((nwarn + 1)); printf '  warn  %s\n' "$1"; shift; local l; for l; do printf '        %s\n' "$l"; done; }
  user=$(id -un)

  v=$(os_release PRETTY_NAME)
  printf 'paddock %s on %s\n' "$PADDOCK_VERSION" "${v:-$(uname -s)}"

  if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))); then
    ok "bash $BASH_VERSION"
  else bad "bash $BASH_VERSION is older than 4.4"; fi

  if ((EUID == 0)); then bad "running as root" "paddock uses rootless Podman; run it as your normal user"
  else ok "running as $user (uid $EUID)"; fi

  if DATA_DIR=$(find_data_dir 2>/dev/null); then ok "data dir $DATA_DIR"
  else bad "data dir not found" "install with ./install.sh, or set PADDOCK_DATA_DIR"; fi

  if command -v curl >/dev/null 2>&1; then ok "curl"
  else meh "curl not found" "needed by 'paddock build' without --version; install curl"; fi

  for c in newuidmap newgidmap; do command -v "$c" >/dev/null 2>&1 || missing+=" $c"; done
  if [[ -z $missing ]]; then ok "newuidmap/newgidmap"
  else bad "missing:$missing (needed for rootless Podman)" "install the package that provides them, see $PODMAN_DOCS"; fi

  # Subordinate IDs: /etc/subuid and /etc/subgid list the user by name or uid.
  ((EUID == 0)) || for c in subuid subgid; do
    if grep -qsE "^($user|$EUID):" "/etc/$c"; then ok "/etc/$c has an entry for $user"
    else bad "/etc/$c has no entry for $user" \
      "sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 $user" \
      "then: podman system migrate"; fi
  done

  if [[ -e /dev/net/tun && ! ( -r /dev/net/tun && -w /dev/net/tun ) ]]; then
    bad "/dev/net/tun is not accessible to $user" "rootless networking (slirp4netns/pasta) needs it; on a normal host it is mode 0666"
  fi

  if [[ -r /sys/fs/selinux/enforce && $(cat /sys/fs/selinux/enforce) == 1 ]]; then
    local relabel
    relabel=$( [[ -n $DATA_DIR ]] && { load_config; printf '%s' "${CFG[relabel]-}"; } 2>/dev/null )
    if [[ -n $relabel ]]; then ok "SELinux enforcing, relabel=$relabel"
    else meh "SELinux is enforcing but relabel is empty" \
      "the agent cannot use the workspace; set relabel=Z in ${CONFIG_DIR/#$HOME/\~}/config"; fi
  fi

  if ! command -v podman >/dev/null 2>&1; then
    bad "podman not found" "install Podman >= $PODMAN_MIN with netavark: $PODMAN_DOCS"
  else
    v=$(podman --version 2>/dev/null | awk '{print $NF}')
    if version_ge "${v:-0}" "$PODMAN_MIN"; then ok "podman $v"
    else bad "podman ${v:-?} is older than $PODMAN_MIN" \
      "paddock needs netavark network isolation; use a newer distro release or Podman build"; fi

    if ((EUID == 0)); then :
    elif ! info=$(podman info --format '{{.Host.Security.Rootless}}|{{.Host.NetworkBackend}}|{{.Host.CgroupsVersion}}|{{range .Host.CgroupControllers}}{{.}} {{end}}' 2>/dev/null); then
      bad "'podman info' failed" "run it to see why (often: missing subuid/subgid, or run 'podman system migrate')"
    else
      IFS='|' read -r rootless backend cgv ctrls <<<"$info"
      if [[ $rootless == true ]]; then ok "podman is rootless"
      else bad "podman is not rootless" "unset CONTAINER_HOST / remote connections and run as a normal user"; fi
      if [[ $backend == netavark ]]; then ok "network backend netavark"
      else bad "network backend is '${backend:-?}', paddock needs netavark" \
        "install netavark and aardvark-dns, set network_backend=\"netavark\" under [network] in ~/.config/containers/containers.conf," \
        "then 'podman system reset' (deletes all your containers and images)"; fi
      missing=""
      for c in memory cpu pids; do [[ " $ctrls " == *" $c "* ]] || missing+=" $c"; done
      if [[ $cgv != v2 ]]; then meh "cgroups $cgv: memory/CPU/pids limits are ignored" "boot with cgroup v2 (systemd.unified_cgroup_hierarchy=1) to enforce them"
      elif [[ -n $missing ]]; then meh "cgroup controllers not delegated to $user:$missing (those limits are ignored)" \
        "see https://rootlesscontaine.rs/getting-started/common/cgroup2/"
      else ok "cgroup v2 with memory, cpu and pids delegated"; fi
    fi
  fi

  printf '%d problem(s), %d warning(s)\n' "$nfail" "$nwarn"
  ((nfail == 0))
}

usage() {
  cat <<EOF
paddock $PADDOCK_VERSION - isolated coding-agent instances on rootless Podman

Usage: paddock <command> [args]

  create <tool> <name> <path> [--domains d1,d2,...]   create an instance (not started)
         [--packages p1,p2,...]                       ... with extra pacman packages
  start <name>                                        start proxy, then agent
  attach <name> [--yolo] [-- tool args]               run the tool in /workspace
  shell <name>                                        bash in the agent container
  stop <name>                                         stop agent and proxy
  rm <name> [--force]                                 remove instance (workspace kept)
  recreate <name>                                     recreate containers (e.g. after build)
  list                                                list instances
  domains <name> list|add|rm|edit [domain...]         manage the instance allowlist
  packages <name> list|add|rm|edit [package...]       manage the instance's extra packages
  logs <name> [-f] [-n N] [--raw]                     proxy log of allowed/denied requests
  build <tool> [--version X] [--refresh]              build proxy, base and tool images
  tools                                               list available tools
  doctor                                              check that this host can run paddock
  purge [--force] [--keep-images]                     remove all instances, images and config

Tools:   $( [[ -n $DATA_DIR ]] && list_tools | paste -sd' ')
Config:  $CONFIG_DIR (a file here overrides the data dir file at the same path)
Data:    ${DATA_DIR:-(not found)}
Domains: example.com (exact) or .example.com (domain + subdomains).
EOF
}

main() {
  local cmd=${1-help}; (($#)) && shift
  case $cmd in
    help|-h|--help) DATA_DIR=$(find_data_dir 2>/dev/null) || DATA_DIR=""; usage; return 0 ;;
    version|--version) echo "paddock $PADDOCK_VERSION"; return 0 ;;
    doctor) cmd_doctor "$@"; return ;;
    # For shell completion: no podman, no config dir created, no errors.
    __complete-tools) DATA_DIR=$(find_data_dir 2>/dev/null) || return 0; list_tools; return 0 ;;
  esac
  ((EUID != 0)) || die "run paddock as a normal user, not root"
  # Before init_config_dir: works without a data dir and must not recreate
  # the config dir it is about to delete.
  [[ $cmd == purge ]] && { cmd_purge "$@"; return; }
  need_cmd podman
  init_config_dir
  case $cmd in
    create)   cmd_create "$@" ;;
    start)    cmd_start "$@" ;;
    attach)   cmd_attach "$@" ;;
    shell)    cmd_shell "$@" ;;
    stop)     cmd_stop "$@" ;;
    rm)       cmd_rm "$@" ;;
    recreate) cmd_recreate "$@" ;;
    list|ls)  cmd_list "$@" ;;
    domains)  cmd_domains "$@" ;;
    packages) cmd_packages "$@" ;;
    logs)     cmd_logs "$@" ;;
    build)    cmd_build "$@" ;;
    tools)    cmd_tools "$@" ;;
    *) usage >&2; die "unknown command '$cmd'" ;;
  esac
}

main "$@"
